# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Academic Search APIs
# Semantic Scholar API key is optional for basic use, but recommended to avoid 429 rate limits
SEMANTIC_SCHOLAR_API_KEY=
# Rate limit delay for arXiv requests in seconds (recommended >= 3.0)
ARXIV_REQUEST_DELAY_SECONDS=3.0

# Database Configuration (Docker Compose default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/research_db

# Research Pipeline Limits
MAX_PAPERS_PER_TASK=10
SEARCH_TIMEOUT_SECONDS=15
MAX_REVISION_CYCLES=2

# Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mas-research-assistant

